<li class="bg-surface border rounded-lg px-4 py-3">
  <% has_personal_note = payment.personal_amount.positive? %>
  <% action_icons = capture do %>
    <div class="not-edit-mode:hidden flex gap-1 shrink-0">
      <a href="<%= edit_group_payment_path(group.token, payment) %>"
         class="p-1.5 rounded text-content-4 hover:text-brand hover:bg-surface-sunken">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
        </svg>
        <span class="sr-only">編集</span>
      </a>
      <%= button_to group_payment_path(group.token, payment),
          method: :delete,
          class: "p-1.5 rounded text-danger-soft hover:text-danger-strong hover:bg-danger-surface",
          form: { data: { turbo_confirm: "「#{payment.description}」を削除しますか？" } } do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
        </svg>
        <span class="sr-only">削除</span>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-between items-start">
    <div class="min-w-0">
      <span class="text-xs text-content-3"><%= payment.payer.name %></span>
      <p class="font-medium"><%= payment.description %></p>
    </div>
    <p class="font-bold whitespace-nowrap shrink-0 ml-3"><%= number_with_delimiter(payment.amount) %>円</p>
  </div>

  <div class="flex justify-between items-center gap-2 mt-1">
    <p class="text-xs text-content-4 min-w-0">
      対象: <%= payment.payment_participants.map { |pp| pp.member.name }.join(", ") %>
    </p>
    <%= action_icons unless has_personal_note %>
  </div>

  <% if has_personal_note %>
    <div class="flex justify-between items-center gap-2 mt-1">
      <p class="text-xs text-content-4 min-w-0">
        うち<%= number_with_delimiter(payment.personal_amount) %>円は自分用（精算対象外）
      </p>
      <%= action_icons %>
    </div>
  <% end %>
</li>
