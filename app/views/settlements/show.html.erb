<% content_for :title, "精算結果 — #{@group.name} | Okanjo" %>

<div class="w-full max-w-md mx-auto">
  <div class="mb-6">
    <a href="<%= group_show_path(@group.token) %>" class="text-sm text-content-3 hover:text-content-1">← <%= @group.name %></a>
    <h1 class="text-2xl font-bold mt-2">精算結果</h1>
  </div>

  <div class="mb-5">
    <p class="text-xs text-content-3 mb-2">精算アルゴリズム</p>
    <div class="flex text-sm rounded-lg border border-line overflow-hidden w-fit">
      <%= link_to "支払い回数を最小化",
            group_settlements_path(@group.token, algo: "optimal"),
            class: "px-4 py-1.5 #{@algo == 'optimal' ? 'bg-surface-inverse text-on-inverse' : 'bg-surface text-content-2 hover:bg-surface-sunken'}",
            data: { turbo_prefetch: false } %>
      <div class="w-px bg-line"></div>
      <%= link_to "シンプルに計算",
            group_settlements_path(@group.token, algo: "greedy"),
            class: "px-4 py-1.5 #{@algo == 'greedy' ? 'bg-surface-inverse text-on-inverse' : 'bg-surface text-content-2 hover:bg-surface-sunken'}",
            data: { turbo_prefetch: false } %>
    </div>
  </div>

  <% if @repayments.empty? %>
    <div class="bg-success-surface border border-success-line rounded-lg px-4 py-6 text-center mb-6">
      <p class="text-success-strong font-medium">精算の必要はありません！</p>
      <p class="text-sm text-success mt-1">全員の収支がつり合っています</p>
    </div>
  <% else %>
    <div class="mb-2 text-sm text-content-3">
      <span class="font-bold text-content-1"><%= @repayments.size %></span> 回の支払いで精算できます
    </div>

    <ul class="space-y-3 mb-6">
      <% @repayments.each do |r| %>
        <li class="bg-surface border rounded-lg px-4 py-3 flex justify-between items-center">
          <div class="flex items-center gap-2">
            <span class="font-medium"><%= r[:from].name %></span>
            <span class="text-content-4">→</span>
            <span class="font-medium"><%= r[:to].name %></span>
          </div>
          <span class="font-bold"><%= number_with_delimiter(r[:amount]) %>円</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <section class="mb-8">
    <h2 class="text-sm font-semibold text-content-3 mb-3">各自の収支</h2>
    <ul class="space-y-2">
      <% @balances.each do |b| %>
        <li class="flex justify-between items-center text-sm py-1 border-b last:border-b-0">
          <span><%= b[:member].name %></span>
          <span class="font-medium <%= b[:balance] >= 0 ? 'text-positive' : 'text-negative' %>">
            <%= b[:balance] >= 0 ? '+' : '' %><%= number_with_delimiter(b[:balance]) %>円
          </span>
        </li>
      <% end %>
    </ul>
  </section>

  <div class="flex flex-col gap-2 mb-6">
    <%= link_to "立替払い一覧をダウンロード",
          group_settlements_payments_csv_path(@group.token),
          class: "btn-secondary text-center",
          data: { turbo: false } %>
    <%= link_to "精算結果をダウンロード",
          group_settlements_results_csv_path(@group.token, algo: @algo),
          class: "btn-secondary text-center",
          data: { turbo: false } %>
  </div>
</div>
